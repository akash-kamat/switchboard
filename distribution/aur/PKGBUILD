pkgname=switchboard-bin
pkgver=0.1.2
pkgrel=1
pkgdesc="Lightweight dashboard for system services and Docker containers"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/akash-kamat/switchboard"
license=('MIT')
depends=('systemd')
source_x86_64=("switchboard_0.1.2_linux_amd64.tar.gz::https://github.com/akash-kamat/switchboard/releases/download/v0.1.2/switchboard_linux_amd64.tar.gz")
source_aarch64=("switchboard_0.1.2_linux_arm64.tar.gz::https://github.com/akash-kamat/switchboard/releases/download/v0.1.2/switchboard_linux_arm64.tar.gz")
source_armv7h=("switchboard_0.1.2_linux_armv7.tar.gz::https://github.com/akash-kamat/switchboard/releases/download/v0.1.2/switchboard_linux_armv7.tar.gz")
sha256sums_x86_64=('45ed08622f9734e629c645dec9bf79a727298cb6b793b26fa597c27bc19b216e')
sha256sums_aarch64=('e3c0ef8d10228ee76961b424a6cdbccb9da8f616d7bf276a417a5de0b036a3a7')
sha256sums_armv7h=('d7d5559ff77ee8e0bcb09b6e67306ee691551d4e324b974378b1815c69c40923')

package() {
  install -Dm755 "$srcdir/switchboard" "$pkgdir/usr/bin/switchboard"
  install -Dm644 "$srcdir/config.example.yaml" "$pkgdir/etc/switchboard/config.yaml"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
